{
  "expo": {
    "name": "First Time Flyer",
    "slug": "first-time-flyer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.popoturapps.firsttimefly",
      "versionCode": 3,
      "name": "First Time Flyer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "dfb0e0a5-d665-4148-b512-1078043875a8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.popoturapps.firsttimefly"
    }
  }
}
